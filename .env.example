# ---- Database ----
# Leave empty to boot the local embedded PostgreSQL automatically (npm run db:setup).
# Set to a connection string to use an external PostgreSQL instance instead.
DATABASE_URL=

# ---- Auth (Clerk) ----
# Get keys at https://dashboard.clerk.com -> your app -> API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---- Firebase (optional) ----
# Web app config identifiers from console.firebase.google.com → Project settings.
# Safe to expose in the client bundle; access control is via Firebase Security Rules.
# Leave empty to run without Firebase entirely.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- AI provider (optional) ----
# The deterministic analysis/schema engine works with NO key configured.
# When set, schema suggestions are enhanced with AI (OpenAI-compatible API).
# Totally free (no credit card) presets — pick one via AI_PROVIDER:
#   groq | cerebras | mistral | gemini | huggingface | llm7
# Get a key in <1 min:
#   Groq (recommended):  https://console.groq.com/keys
#   Cerebras:            https://cloud.cerebras.ai/
#   Mistral:             https://console.mistral.ai/api-keys
#   Gemini:              https://aistudio.google.com/app/apikey
#   Hugging Face:        https://huggingface.co/settings/tokens
#   LLM7.io:             https://token.llm7.io
AI_API_KEY=
AI_PROVIDER=groq
AI_BASE_URL=
AI_MODEL=
# Explicit override examples (AI_BASE_URL/AI_MODEL win over AI_PROVIDER):
#   Groq:       AI_BASE_URL=https://api.groq.com/openai/v1  AI_MODEL=llama-3.3-70b-versatile
#   Cerebras:   AI_BASE_URL=https://api.cerebras.ai/v1      AI_MODEL=llama3.1-70b
#   Gemini:     AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  AI_MODEL=gemini-2.0-flash
#   Mistral:    AI_BASE_URL=https://api.mistral.ai/v1       AI_MODEL=open-mistral-7b
#   HuggingFace:AI_BASE_URL=https://router.huggingface.co/v1 AI_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
#   LLM7:       AI_BASE_URL=https://api.llm7.io/v1          AI_MODEL=gpt-oss-20b

# ---- Google OAuth (via Clerk dashboard, not env) ----
# Enable Google in Clerk Dashboard -> Social connections. No env vars needed.

# ---- Billing (mock mode for MVP) ----
# Payment provider selector. Only "mock" is implemented: plan changes apply
# immediately with no charges. A real provider (e.g. Stripe) plugs into
# src/lib/billing/provider.ts; its secrets would live here, never in code.
BILLING_PROVIDER=mock
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Platform admins (the SheetApp team /admin surface) ----
# Comma OR whitespace separated Clerk user IDs (user_...). Unset/empty = the
# /admin surface is closed for everyone (secure default). Workspace org-role
# ADMIN never grants /admin access.
# PLATFORM_ADMIN_CLERK_IDS=user_REPLACE_WITH_YOUR_CLERK_USER_ID

# ---- File storage (production) ----
# Local disk is the default (single-instance only). On Vercel, create a Blob
# store (Dashboard → Storage → Blob) and set its token: uploads then live in
# object storage and survive redeploys. Large uploads also bypass the 4.5 MB
# serverless body limit only when uploaded direct-to-storage.
BLOB_READ_WRITE_TOKEN=

# ---- Early access (landing page counter) ----
# The pricing counter shows (1000 - registered users) remaining spots.
# The app first tries the real user count from the database and falls back
# to this value when the database is unreachable (e.g. during a build).
EARLY_ACCESS_CURRENT_USERS=153
